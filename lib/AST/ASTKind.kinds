# name minkids maxkids category1 category2
Categories:	Term	Form

# Leaf nodes.
UNDEFINED	0	0
SYMBOL		0	0	Term	Form 

# These always produce terms
BVCONST		0	0	Term
BVNOT		1	1	Term
BVCONCAT	2	-	Term
BVOR		1	-	Term
BVAND		1	-	Term
BVXOR		1	-	Term
BVNAND		1	-	Term
BVNOR		1	-	Term
BVXNOR		1	-	Term
BVEXTRACT	3	3	Term
BVLEFTSHIFT	3	3	Term
BVRIGHTSHIFT	3	3	Term
BVSRSHIFT	3	3	Term
BVPLUS		1	-	Term
BVSUB		2	2	Term
BVUMINUS	1	1	Term
BVMULT		1	-	Term
BVDIV		2	2	Term
BVMOD		2	2	Term
SBVDIV		2	2	Term
SBVREM		2	2	Term
SBVMOD		2	2	Term
BVSX		1	1	Term
BVZX		1	1	Term
#BOOLVEC         0       -       Term

# Formula OR term, depending on context
ITE		3	3	Term	Form

# These produce formulas.
BOOLEXTRACT	2	2	Form
BVLT		2	2	Form
BVLE		2	2	Form
BVGT		2	2	Form
BVGE		2	2	Form
BVSLT		2	2	Form
BVSLE		2	2	Form
BVSGT		2	2	Form
BVSGE		2	2	Form
BVUADDO		2	2	Form
BVSADDO		2	2	Form
BVUMULO		2	2	Form
BVSMULO		2	2	Form
BVUSUBO		2	2	Form
BVSSUBO		2	2	Form
EQ		2	2	Form
FALSE		0	0	Form
TRUE		0	0	Form
NOT		1	1	Form
AND		1	-	Form
OR		1	-	Form
NAND		1	-	Form
NOR		1	-	Form
XOR		1	-	Form
IFF		1	-	Form
IMPLIES		2	2	Form
PARAMBOOL       2       2       Form

# array operations
READ		2	2	Term
WRITE		3	3	Term

#Types: These kinds are used only in the API. Once processed inside
#the API, they are never used again in the system 
ARRAY           0       0
BITVECTOR       0       0
BOOLEAN         0       0
FLOATINGPOINT   0       0

# Floating point _terms_ (i.e., things that produce FPs)

# fp.abs: fp -> fp
FP_ABS                      1    1    Term

# fp.neg: fp -> fp
FP_NEG                      1    1    Term

# fp.add: rm, fp, fp -> fp
FP_ADD                      3    3    Term

# fp.sub: rm, fp, fp -> fp
FP_SUB                      3    3    Term

# fp.mul: rm, fp, fp -> fp
FP_MUL                      3    3    Term

# fp.div: rm, fp, fp -> fp
FP_DIV                      3    3    Term

# fp.fma: rm, fp, fp, fp -> fp
FP_FMA                      4    4    Term

# fp.sqrt: rm, fp -> fp
FP_SQRT                     2    2    Term

# fp.rem: fp, fp -> fp
FP_REM                      2    2    Term

# fp.roundToIntegral: rm, fp -> fp
FP_ROUNDTOINTEGRAL          2    2    Term

# fp.min: fp, fp -> fp
FP_MIN                      2    3    Term

# fp.max: fp, fp -> fp
FP_MAX                      2    3    Term

# to_fp: eb, sb, bv -> fp
# to_fp: eb, sb, rm, fp -> fp
# to_fp: eb, sb, rm, bv -> fp
FP_TOFP                     3   4    Term

# to_fp_unsigned: eb, sb, rm, bv -> fP
FP_TOFP_UNSIGNED            4    4    Term

# fp.to_ubv: bw, rm, fp -> bv
FP_TO_UBV                   3    4    Term

# fp.to_sbv: bw, rm, fp -> bv
FP_TO_SBV                   3    4    Term

# Floating point _formulae_ (i.e., things that produce Booleans)

# fp.leq: fp, fp -> bool
FP_LEQ              2    _    Form

# fp.lt: fp, fp -> bool
FP_LT               2    _    Form

# fp.geq: fp, fp -> bool
FP_GEQ              2    _    Form

# fp.gt: fp, fp -> bool
FP_GT               2    _    Form

# fp.eq: fp, fp -> bool
FP_EQ               2    _    Form

# fp.isNormal: fp -> bool
FP_ISNORMAL         1    1    Form

# fp.isSubnormal: fp -> bool
FP_ISSUBNORMAL      1    1    Form

# fp.isZero: fp -> bool
FP_ISZERO           1    1    Form

# fp.isInfinite: fp -> bool
FP_ISINFINITE       1    1    Form

# fp.isNaN: fp -> bool
FP_ISNAN            1    1    Form

# fp.isNegative: fp -> bool
FP_ISNEGATIVE       1    1    Form

# fp.isPositive: fp -> bool
FP_ISPOSITIVE       1    1    Form

# FP `=`
FP_SMT_EQ           2    2    Form

# Floating point _constants_

# NaN
FP_CONST_NAN              0    0    Term

# +oo
FP_CONST_POS_INF          0    0    Term

# -oo
FP_CONST_NEG_INF          0    0    Term

# +zero
FP_CONST_POS_ZERO         0    0    Term

# -zero
FP_CONST_NEG_ZERO         0    0    Term
