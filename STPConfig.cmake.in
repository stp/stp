# Config file for the @EXPORT_TYPE@ STP Package
# It defines the following variables
#  STP_INCLUDE_DIRS - include directories for STP
#  STP_STATIC_LIBRARY - static library target (empty if not built)
#  STP_SHARED_LIBRARY - dynamic library target (empty if not built)
#  STP_EXECUTABLE     - the stp executable
#  STP_VERSION_*      - the stp MAJOR/MINOR/PATCH versions
#  STP_VERSION        - the stp complete version string

# Compute paths
get_filename_component(STP_CMAKE_DIR "${CMAKE_CURRENT_LIST_FILE}" PATH)
# For an installed package this is written relative to this file, so that the
# installation can be moved or staged under a different prefix than the one it
# was configured with. get_filename_component resolves the ".." rather than
# leaving them for the compiler command line.
get_filename_component(STP_INCLUDE_DIRS "@CONF_INCLUDE_DIRS@" ABSOLUTE)


# Only when it came from a CMake package. A CryptoMiniSat this build built
# itself (rung 3 of cmake/FindCryptoMiniSat.cmake) is named by archive path in
# the targets file below, like every other dependency built here, and there is
# no package for a consumer to find.
if ("@USE_CRYPTOMINISAT@" STREQUAL "ON" AND "@STP_CMS_FROM_PACKAGE@")
    include(CMakeFindDependencyMacro)
    # CryptoMiniSat >= 5.14 installs its bundled CaDiCaL and cadiback as
    # sibling packages, and cryptominisat5Targets.cmake requires imported
    # targets by those names to already exist: CryptoMiniSat's own config
    # does not find them, so its consumer has to. Quiet and optional,
    # exactly as STP's own configure does the same two lookups -- an older
    # or shared CryptoMiniSat needs neither.
    find_package(cadical CONFIG QUIET)
    find_package(cadiback CONFIG QUIET)
    # cryptominisat5Targets names Threads::Threads in its link interface, and
    # nothing recreates it for a consumer. It only bites a static STP, which
    # is the only kind that propagates CryptoMiniSat at all -- a shared one
    # resolved it inside libstp.so long before the package was written.
    find_dependency(Threads)
    find_dependency(cryptominisat5)
endif()

# Our library dependencies (contains definitions for IMPORTED targets)
include("${STP_CMAKE_DIR}/@STP_TARGETS_FILENAME@")

# These are IMPORTED targets created by @STP_TARGETS_FILENAME@
set(STP_EXECUTABLE stp)

set(STP_STATIC_LIBRARY stp)
set(STP_SHARED_LIBRARY stp)

# Note version variables are implicitly set by STPConfigVersion.cmake
