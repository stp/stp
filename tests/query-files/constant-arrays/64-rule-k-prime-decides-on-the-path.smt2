; Eighty writes elsewhere, more than the sixty-four indexes; each path
; between two of these constant arrays crosses two.
(push 1)
(assert (= (select B q) #x05))
(assert (= a0 a1))
(assert (= a1 a2))
(assert (= a2 a3))
(assert (= a3 a4))
(assert (= a4 a5))
(assert (= a5 a6))
(assert (= a6 a7))
(assert (not (= d0 d7)))
