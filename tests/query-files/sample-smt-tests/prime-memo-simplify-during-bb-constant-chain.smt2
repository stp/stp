; RUN: %solver --bb.simplify-during-bb=1 --rewriting=0 --use-intervals=0 --disable-cbitp %s | %OutputCheck %s
; CHECK: ^sat$
;
; x0 is zero at the bit level but not at the word level, so
; simplify_during_bb rewrites every x_i to a constant while blasting. The
; chain is deep enough for the bit-blaster to prime its memos. BBTerm used
; to memoise only the rewrite, never the node asked for, so each call on an
; x_i missed and re-derived the chain below it. The time was exponential in
; the chain's length beyond the recursion budget: 521 levels 0.1s, 526
; 4.3s, 530 over 100s. Assertions builds also aborted in PrimeAudit, here at
; 547 frames against a claim of 544.
(set-logic QF_BV)
(declare-fun v () (_ BitVec 8))
(declare-fun w () (_ BitVec 8))
(define-fun x0 () (_ BitVec 8) (bvlshr v (bvor w #x08)))
(define-fun x1 () (_ BitVec 8) (bvand x0 (bvadd w #x00)))
(define-fun x2 () (_ BitVec 8) (bvmul x1 (bvadd w #x01)))
