(declare-fun x () (_ BitVec 64))
(declare-fun y () (_ BitVec 64))
(assert (bvult (bvmul x y) (_ bv18446744073709551615 64)))
(push 1)
(assert (= x (_ bv1000003 64)))
(assert (= y (_ bv65537 64)))
(check-sat)
