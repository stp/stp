; RUN: %solver --array-equality %s | %OutputCheck %s
; CHECK-NEXT: ^unsat
; The fifty-one values of (_ FloatingPoint 2 4) -- fifty non-NaN
; patterns and the one NaN -- are each pinned pointwise equal, so the
; arrays are equal: the disequality may not be "witnessed" at any of
; the thirteen further NaN bit patterns, none of which denotes a
; fifty-second index. (Answered sat before the witness index was
; confined to denoting patterns.)
;
; The smallest format this can be written in: symfpu cannot unpack a
; significand of 3 bits or fewer, so (_ FloatingPoint 2 2) -- which
; would need only fifteen of these -- is refused outright.
(set-logic QF_ABVFP)
(declare-fun a () (Array (_ FloatingPoint 2 4) (_ BitVec 8)))
(declare-fun b () (Array (_ FloatingPoint 2 4) (_ BitVec 8)))
(assert (not (= a b)))
(assert (= (select a (fp #b0 #b00 #b000)) (select b (fp #b0 #b00 #b000))))
(assert (= (select a (fp #b0 #b00 #b001)) (select b (fp #b0 #b00 #b001))))
(assert (= (select a (fp #b0 #b00 #b010)) (select b (fp #b0 #b00 #b010))))
(assert (= (select a (fp #b0 #b00 #b011)) (select b (fp #b0 #b00 #b011))))
(assert (= (select a (fp #b0 #b00 #b100)) (select b (fp #b0 #b00 #b100))))
(assert (= (select a (fp #b0 #b00 #b101)) (select b (fp #b0 #b00 #b101))))
(assert (= (select a (fp #b0 #b00 #b110)) (select b (fp #b0 #b00 #b110))))
(assert (= (select a (fp #b0 #b00 #b111)) (select b (fp #b0 #b00 #b111))))
(assert (= (select a (fp #b0 #b01 #b000)) (select b (fp #b0 #b01 #b000))))
(assert (= (select a (fp #b0 #b01 #b001)) (select b (fp #b0 #b01 #b001))))
(assert (= (select a (fp #b0 #b01 #b010)) (select b (fp #b0 #b01 #b010))))
