; RUN: %solver --SMTLIB2 %s | %OutputCheck %s
;
; A function applied at a sliding offset. No two of these arguments can ever
; be equal, so not one of the C(n,2) pairs needs a congruence constraint --
; but saying so takes linear arithmetic, because the node factory holds no
; Real rewrites and answers "cannot tell" for every symbolic Real pair.
; Without that reasoning this shape builds an atom and an implication per
; pair, all of them with unsatisfiable premises, and does not finish.
(set-logic QF_UFLRA)
(declare-fun f (Real) Real)
(declare-fun x () Real)
(assert (> (f (+ x 0.0)) 0.0))
(assert (> (f (+ x 1.0)) 1.0))
(assert (> (f (+ x 2.0)) 2.0))
(assert (> (f (+ x 3.0)) 3.0))
(assert (> (f (+ x 4.0)) 4.0))
(assert (> (f (+ x 5.0)) 5.0))
