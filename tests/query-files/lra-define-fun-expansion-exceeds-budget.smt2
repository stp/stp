; RUN: not %solver --SMTLIB2 %s 2>&1 | %OutputCheck %s
;
; Expanding a define-fun rebuilds the body's nodes through the node factory,
; which folds constant Real arithmetic through CreateRealTerm -- so a macro
; over Reals can exhaust the number budget while it expands, exactly as a
; written-out literal can.  createExactRealTerm guarded the literal path and
; nothing guarded this one: SMT2Parse() catches only DeclassifiedNameAbandon,
; so the NumberFailure escaped the parse and reached std::terminate.  That is
; SIGABRT and exit 134 with no (error ...) line, where the identical overflow
; written as a literal is a clean syntax error and exit 255.
;
; Eight applications of a 9000-digit coefficient, so the product crosses the
; 64 KiBit numerator limit on the third nesting.  Deliberately shallow: the
; nesting is three deep, because the point is the budget refusal and not the
; unbounded macro recursion that a deeper file also runs into.
; CHECK-L: define-fun expansion failed
; CHECK-L: numerator bits exceeds configured maximum
(set-logic QF_LRA)
(declare-fun r () Real)
(define-fun f0 ((x Real)) Real (* x .0))
(define-fun f1 ((x Real)) Real (f0 (f0 x)))
(define-fun f2 ((x Real)) Real (f1 (f1 x)))
(define-fun f3 ((x Real)) Real (f2 (f2 x)))
(assert (> (f3 2.0) 0.0))
(check-sat)
(exit)
