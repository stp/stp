; RUN: %solver %s | %OutputCheck %s
(set-logic QF_AUFBV)
(define-sort Byte () (_ BitVec 8))
(declare-const p Bool)
(declare-const x Byte)
(declare-const a (Array Byte Byte))
(declare-fun f (Byte) Byte)
(declare-fun predicate (Byte) Bool)
(define-fun inc ((v Byte)) Byte (bvadd v #x01))
(define-const yes Bool true)
(assert (as p Bool))
(assert ((as and Bool) (as true Bool) (as yes Bool)))
(assert ((as = Bool) (as x Byte) (as (_ bv42 8) Byte)))
(assert (= ((as inc Byte) x) ((as bvadd Byte) x #x01)))
(assert (= ((as f Byte) x) #x11))
(assert ((as predicate Bool) x))
(assert (= ((as select Byte) ((as store (Array Byte Byte)) a x #x03) x) #x03))
(assert (= ((as (_ extract 7 4) (_ BitVec 4)) x) #x2))
(assert (= ((as (_ zero_extend 8) (_ BitVec 16)) x) #x002a))
(assert (= ((as (_ sign_extend 8) (_ BitVec 16)) x) #x002a))
(assert (= ((as (_ repeat 2) (_ BitVec 16)) x) #x2a2a))
(assert (= ((as (_ rotate_left 8) Byte) x) x))
(assert (= ((as (_ rotate_right 8) Byte) x) x))
(assert (= ((as ite Byte) p x #x00) x))
(assert ((as bvult Bool) x #x80))
; CHECK: ^sat$
(check-sat)
(reset)
(set-logic QF_BVFP)
(assert (= (as RNE RoundingMode) RNE))
(assert (= (as (_ +zero 8 24) Float32) (_ +zero 8 24)))
(assert ((as fp.isNaN Bool) (as (_ NaN 8 24) Float32)))
(assert (= ((as (_ to_fp 8 24) Float32) #x00000000) (_ +zero 8 24)))
(assert (= ((as fp.add Float32) RNE (_ +zero 8 24) (_ +zero 8 24)) (_ +zero 8 24)))
(assert (= ((as (_ fp.to_ubv 8) (_ BitVec 8)) RTZ (_ +zero 8 24)) #x00))
; CHECK: ^sat$
(check-sat)
(reset)
(set-logic QF_LRA)
(declare-const r Real)
(assert (= r 1.0))
(assert ((as < Bool) ((as + Real) r r) 3.0))
(assert (= ((as ite Real) true r 0.0) r))
; CHECK: ^sat$
(check-sat)
