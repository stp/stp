; Supported commands and optional refusals in SMT-LIB 2.7 command order.
; Disabled query errors are covered by smtlib_protocol.py.
; RUN: %solver %s | %OutputCheck %s
(set-option :print-success false)
(set-option :produce-models true)
(set-option :produce-assertions true)
(set-option :produce-proofs true)
(set-option :produce-unsat-cores true)
(set-option :produce-unsat-assumptions true)
(set-option :produce-assignments true)
(set-option :global-declarations false)
(set-option :interactive-mode false)
(set-option :random-seed 0)
(set-option :verbosity 0)
(set-option :reproducible-resource-limit 0)
(set-option :diagnostic-output-channel "stdout")
(set-option :regular-output-channel "stdout")
(get-option :print-success)
(get-info :name)
(get-info :version)
(get-info :error-behavior)
(get-info :assertion-stack-levels)
(get-info :all-statistics)
(get-info :authors)
(set-logic QF_ABV)
(set-info :status sat)
(set-info :source "STP command coverage test")
(declare-sort S 0)
(define-sort BV4 () (_ BitVec 4))
(declare-const c (_ BitVec 4))
(declare-fun x () (_ BitVec 4))
(declare-fun p () Bool)
(declare-fun a () (Array (_ BitVec 4) (_ BitVec 4)))
(define-fun g () (_ BitVec 4) (_ bv2 4))
(define-fun-rec h () (_ BitVec 4) (_ bv2 4))
(define-funs-rec ((k () (_ BitVec 4))) ((_ bv2 4)))
(declare-datatype D ((leaf)))
(declare-datatypes ((E 0)) (((node))))
(push 1)
(assert (= x #x1))
(get-assertions)
; CHECK: ^sat
(check-sat)
(get-model)
(get-value (x))
(pop 1)
(push 1)
(assert (and p (not p)))
; CHECK: ^unsat
(check-sat)
(get-info :all-statistics)
(get-unsat-assumptions)
(get-unsat-core)
(pop 1)
(push 1)
(assert (= x #x1))
(check-sat-assuming (p))
(check-sat-assuming ())
(pop 1)
(reset-assertions)
(reset)
; The script survived every command above.
; CHECK: REACHED-END
(echo "REACHED-END")
(exit)
