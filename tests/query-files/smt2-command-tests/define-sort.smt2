; RUN: %solver %s | %OutputCheck %s
(set-option :produce-models true)
(set-logic QF_AUFBVFP)
(define-sort Word () (_ BitVec 8))
(define-sort Flag () Bool)
(define-sort Float () Float32)
(define-sort Mode () RoundingMode)
(define-sort Identity (T) T)
(define-sort Memory (Index Element) (Array Index Element))
(define-sort Bytes () (Memory Word (Identity Word)))
(define-sort Ignore (T) Word)
; A local sort parameter shadows a visible sort without changing that sort.
(define-sort Local (Word) (Identity Word))
(define-sort Shadow (Bool) Bool)
(define-sort ShadowFloat (Float32) Float32)
(declare-const shadow (Shadow Word))
(declare-const shadow-float (ShadowFloat Word))
(declare-const x Word)
(declare-const b Flag)
(declare-const a Bytes)
(declare-const r Mode)
(declare-const f Float)
(declare-fun predicate ((Identity Word)) (Identity Bool))
(define-fun id ((p (Identity Word))) (Ignore Flag) p)
(define-fun truth () Flag true)
(define-const same (Local Word) x)
(assert (= shadow shadow-float))
(assert (and truth (= (id x) #x2a) (= same #x2a)
             b (predicate x) (= (select a x) #x01)
             (= r RNE) (fp.isZero f)))
; CHECK: ^sat$
(check-sat)
(push 1)
(define-sort Temporary () Bool)
(declare-const t Temporary)
(assert t)
; CHECK: ^sat$
(check-sat)
(pop 1)
(define-sort Temporary () Word)
(declare-const t Temporary)
(assert (= t #x00))
; CHECK: ^sat$
(check-sat)
(reset)
(set-logic QF_LRA)
(define-sort Rational () Real)
(define-fun third ((x Rational)) Rational (/ x 3.0))
(assert (= (third 3.0) 1.0))
; CHECK: ^sat$
(check-sat)
