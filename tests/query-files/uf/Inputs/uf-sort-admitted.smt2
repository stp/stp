(declare-fun ok-rm (RoundingMode) Bool)
(declare-fun ok-fp ((_ FloatingPoint 8 24)) Bool)
(declare-fun p (Bool (_ BitVec 8)) Bool)
(assert (= (p true #x00) (p true #x00)))
