(set-logic QF_AUFBV)
(declare-fun f ((_ BitVec 16)) (_ BitVec 16))
(declare-const a (Array (_ BitVec 16) (_ BitVec 16)))
(declare-const x (_ BitVec 16))
(declare-const y (_ BitVec 16))
; Twelve distinct reads, so that they are left to read refinement rather
; than being Ackermannised away up front.
(assert (bvult (bvadd (f x)
                      (select a (bvadd y #x0000))
                      (select a (bvadd y #x0001))
                      (select a (bvadd y #x0002))
                      (select a (bvadd y #x0003))
                      (select a (bvadd y #x0004))
                      (select a (bvadd y #x0005))
                      (select a (bvadd y #x0006))
                      (select a (bvadd y #x0007))
                      (select a (bvadd y #x0008))
                      (select a (bvadd y #x0009))
                      (select a (bvadd y #x000a))
                      (select a (bvadd y #x000b)))
               (bvmul x y)))
(assert (distinct x y))
(check-sat)
