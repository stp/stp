% RUN: %solver %s | %OutputCheck %s
%% Regression level = 3
%% Result = InValid
%% Language = presentation
%
% The rest of this family was converted to SMT-LIB2 -- see
% sample-smt-tests/masked-decrement-chain-sat.smt2, which pins n to the one
% value these constraints allow instead of only checking Invalid.  This copy
% stays in CVC because it is the one place COUNTEREXAMPLE, and the CVC
% counterexample printer behind it, are still exercised end to end.

n: BITVECTOR(32);
c: BITVECTOR(8);
%----------------------------------------------------
ASSERT BVLT(n,0bin00000000000000000000000000010000);
ASSERT NOT ((0bin000000000000000000000000 @ c) 
     = 0bin00000000000000000000000011111110);
ASSERT NOT BVLT(n,0bin00000000000000000000000000001100);
ASSERT NOT ((0bin000000000000000000000000 @ ((0bin000000000000000000000000 
                                       @ c))
      [7:0]) = 0bin00000000000000000000000000000000);
ASSERT NOT ((n & 0bin00000000000000000000000000000011) 
     = 0bin00000000000000000000000000000000);
ASSERT NOT NOT (BVPLUS(32, (n & 0bin00000000000000000000000000000011), 
                BVUMINUS(0bin00000000000000000000000000000001)) 
         = 0bin00000000000000000000000000000000);

%----------------------------------------------------
% CHECK: ^[Ii]nvalid
QUERY FALSE;
COUNTEREXAMPLE;
