% RUN: not %solver %s 2>&1 | %OutputCheck %s
%
% A name that was never declared ends the parse. The grammar reported it and
% then carried on with the name itself standing in for a node, which crashed
% the solver.
x : BITVECTOR(8);
ASSERT(y = 0hex01);
QUERY(x = x);
% CHECK-L: Unresolved symbol:y
% CHECK-L: CVC syntax error: line 7: bad symbol
% CHECK-NOT: Valid.
