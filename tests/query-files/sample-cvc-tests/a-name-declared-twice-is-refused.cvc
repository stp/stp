% RUN: not %solver %s 2>&1 | %OutputCheck %s
%
% One input declaring a name twice is a syntax error, as it always was; a
% name another input or the caller declared may be declared again at its
% type (an API parse), but not a name this input declared already.
x : BITVECTOR(8);
x : BITVECTOR(8);
QUERY(x = x);
% CHECK: CVC syntax error: line 7: syntax error
% CHECK-NOT: Valid
