% RUN: %solver %s | %OutputCheck %s
% CHECK: ^Valid
%
% BVMULT now takes any number of operands in CVC syntax, like BVPLUS --
% the CVC printer has always written the n-ary form, so the grammar must
% read it back. Multiplication is commutative, so reordering the operands
% of a three-way product cannot change its value.

X, Y, Z : BITVECTOR(8);

QUERY BVMULT(8, X, Y, Z) = BVMULT(8, Z, Y, X);
